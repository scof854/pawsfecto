# --- App ---
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://pawfecto.example,https://www.pawfecto.example

# --- Database ---
DATABASE_URL=postgresql://pawfecto:pawfecto@postgres:5432/pawfecto?schema=public

# --- Telegram Bot API ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Target chat (private chat / group / channel id; for groups it starts with -100)
TELEGRAM_CHAT_ID=-1001234567890
# Optional: secret used to verify Telegram webhook updates (set via setWebhook)
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Optional: public URL of /api/telegram/webhook (only required if you run set-webhook script)
TELEGRAM_WEBHOOK_URL=https://api.pawfecto.example/api/telegram/webhook
