generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  PENDING
  SENT
  FAILED
}

model Lead {
  id        String     @id @default(uuid())
  name      String
  phone     String
  email     String?
  message   String?
  source    String?
  metadata  Json?
  status    LeadStatus @default(PENDING)
  attempts  Int        @default(0)
  lastError String?
  sentAt    DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([createdAt])
}
